rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function accessDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/serviceAccess);
    }

    function accessUsers() {
      return get(/databases/$(database)/documents/settings/serviceAccess).data.users;
    }

    // 使用「in」判斷 Map key，避免協作者不在 serviceAccess 時因直接索引不存在 key 而整段 Rules 評估失敗。
    function accessExists() {
      return accessDocExists()
        && email() in accessUsers();
    }

    function profile() {
      return accessUsers()[email()];
    }

    function assistantProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/serviceAssistants/$(email()))
        && get(/databases/$(database)/documents/serviceAssistants/$(email())).data.enabled == true;
    }

    function assistantProfile() {
      return get(/databases/$(database)/documents/serviceAssistants/$(email())).data;
    }

    function legacyProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.enabled == true;
    }

    function enabled() {
      return (accessExists() && profile().enabled == true)
        || assistantProfileExists()
        || legacyProfileExists();
    }

    function role() {
      return accessExists() ? profile().role
        : assistantProfileExists() ? "assistant"
        : "teacher";
    }

    function ownerEmail() {
      return accessExists() && role() == "assistant"
        ? profile().ownerEmail.lower()
        : assistantProfileExists()
          ? assistantProfile().ownerEmail.lower()
          : email();
    }

    function isTeacher() {
      return enabled() && (role() == "teacher" || role() == "admin");
    }

    function legacyManager() {
      return legacyProfileExists()
        && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.role == "admin";
    }

    function canManageAccess() {
      return (accessExists() && profile().enabled == true && profile().role == "admin")
        || legacyManager();
    }

    function syncedTeacher(targetEmail) {
      return accessDocExists()
        && targetEmail in accessUsers()
        && accessUsers()[targetEmail].enabled == true
        && (accessUsers()[targetEmail].role == "teacher"
          || accessUsers()[targetEmail].role == "admin");
    }

    // 正常情況使用 Portal 同步名單驗證；過渡期允許老師依畫面上的既有老師名單轉移。
    function validTransferTarget(targetEmail) {
      return targetEmail is string
        && targetEmail != email()
        && (syncedTeacher(targetEmail) || targetEmail.matches('^[^@]+@[^@]+\\.[^@]+$'));
    }

    match /settings/serviceAccess {
      allow read: if signedIn();
      allow create, update: if canManageAccess();
      allow delete: if false;
    }

    match /serviceAssistants/{assistantEmail} {
      allow get: if signedIn()
        && (assistantEmail == email()
          || (isTeacher() && resource.data.ownerEmail.lower() == email()));
      allow list: if isTeacher();
      allow create: if isTeacher()
        && assistantEmail == request.resource.data.email.lower()
        && request.resource.data.ownerEmail.lower() == email()
        && request.resource.data.role == "assistant";
      allow update: if isTeacher()
        && resource.data.ownerEmail.lower() == email()
        && request.resource.data.ownerEmail.lower() == email()
        && request.resource.data.role == "assistant";
      allow delete: if isTeacher() && resource.data.ownerEmail.lower() == email();
    }

    match /authorizedTeachers/{uid} {
      allow read: if enabled();
      allow write: if false;
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && request.auth.uid == teacherId;
      allow write: if false;
      match /students/{studentId} {
        allow read: if signedIn() && request.auth.uid == teacherId;
        allow write: if false;
        match /records/{recordId} {
          allow read: if signedIn() && request.auth.uid == teacherId;
          allow write: if false;
        }
      }
    }

    match /students/{studentId} {
      allow read: if enabled() && resource.data.ownerEmail.lower() == ownerEmail();

      allow create: if enabled()
        && request.resource.data.ownerEmail.lower() == ownerEmail()
        && request.resource.data.createdBy.lower() == email()
        && request.resource.data.deleted == false;

      allow update: if enabled()
        && resource.data.ownerEmail.lower() == ownerEmail()
        && (
          (
            request.resource.data.ownerEmail == resource.data.ownerEmail
            && request.resource.data.createdBy == resource.data.createdBy
            && (isTeacher() || request.resource.data.deleted == resource.data.deleted)
          )
          ||
          (
            isTeacher()
            && resource.data.deleted != true
            && request.resource.data.ownerEmail != resource.data.ownerEmail
            && validTransferTarget(request.resource.data.ownerEmail.lower())
          )
        );

      allow delete: if false;
    }

    match /records/{recordId} {
      // 個管老師可讀取名下全部紀錄；小幫手只能讀取自己建立的紀錄。
      allow read: if enabled()
        && resource.data.ownerEmail.lower() == ownerEmail()
        && (isTeacher() || resource.data.createdBy.lower() == email());

      allow create: if enabled()
        && request.resource.data.ownerEmail.lower() == ownerEmail()
        && request.resource.data.createdBy.lower() == email()
        && request.resource.data.deleted == false
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.ownerEmail.lower() == ownerEmail();

      allow update: if enabled()
        && resource.data.ownerEmail.lower() == ownerEmail()
        && (isTeacher() || resource.data.createdBy.lower() == email())
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          request.resource.data.ownerEmail == resource.data.ownerEmail
          || (
            isTeacher()
            && request.resource.data.ownerEmail != resource.data.ownerEmail
            && validTransferTarget(request.resource.data.ownerEmail.lower())
          )
        );

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      // 避免小幫手從操作紀錄讀到其他人服務紀錄的修改內容。
      allow read: if enabled()
        && resource.data.ownerEmail.lower() == ownerEmail()
        && (isTeacher() || resource.data.actorEmail.lower() == email());
      allow create: if enabled()
        && request.resource.data.actorEmail.lower() == email()
        && request.resource.data.ownerEmail.lower() == ownerEmail();
      allow update, delete: if false;
    }

    match /transferLogs/{logId} {
      allow read: if enabled()
        && (resource.data.fromEmail.lower() == ownerEmail()
          || resource.data.toEmail.lower() == ownerEmail()
          || resource.data.operatorEmail.lower() == email());
      allow create: if isTeacher()
        && request.resource.data.operatorEmail.lower() == email()
        && request.resource.data.fromEmail.lower() == email()
        && validTransferTarget(request.resource.data.toEmail.lower());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
